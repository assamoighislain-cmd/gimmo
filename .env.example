# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive map & GPS markers.
VITE_GOOGLE_MAPS_API_KEY=""

# WHATSAPP_CLOUD_API_TOKEN: Optional Meta WhatsApp Cloud API permanent/system token for automated PDF dispatch.
WHATSAPP_CLOUD_API_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Optional Meta WhatsApp Business Phone Number ID.
WHATSAPP_PHONE_NUMBER_ID=""

# SUPABASE: Optional Supabase project configuration (server-side secret key stays server-only).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

